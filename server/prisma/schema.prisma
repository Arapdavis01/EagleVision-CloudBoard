generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // optional, for migrations with pooler
}

model User {
  id        String            @id @default(uuid())
  email     String            @unique
  password  String
  createdAt DateTime          @default(now())
  codes     TwoFactorCode[]
}

model TwoFactorCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Project {
  id                 String    @id @default(uuid())
  name               String
  ownerName          String?
  ownerContact       String?
  location           String?
  status             String    @default("active") // active, maintenance, completed, on-hold
  hostingProvider    String?
  deploymentMethod   String?
  dbProvider         String?
  dbHost             String?   // encrypted
  dbName             String?
  dbPort             Int?
  dbUser             String?   // encrypted
  dbPassword         String?   // encrypted
  dbConnectionString String?   // encrypted
  dbNotes            String?
  gitRepoUrl         String?
  liveUrl            String?
  techStack          String?
  version            String?
  lastUpdated        DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  payments           Payment[]

  @@index([status])
  @@index([hostingProvider])
  @@index([dbProvider])
  @@index([location])
}

model Payment {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Float
  paymentDate DateTime
  method      String?  // "mpesa", "bank", "cash"
  notes       String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String
  projectId String?
  ip        String?
  createdAt DateTime @default(now())
}
